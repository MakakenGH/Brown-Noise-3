{
  "name": "Python & JS DevContainer with Aider",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Installs Node.js / JavaScript environment alongside Python
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  // Automatically install aider-chat when the container is created
  "postCreateCommand": "pip install --user --upgrade aider-chat",

  // Point Aider to your local LLM server running on the host machine
  "containerEnv": {
    "OPENAI_API_BASE": "http://host.docker.internal:9931/v1",
    "OPENAI_API_KEY": "sk-not-needed"
  },

  // Ensures host.docker.internal resolves correctly on Linux as well as Mac/Windows
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],

  // Useful VS Code extensions for Python and JavaScript
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "remoteUser": "vscode"
}